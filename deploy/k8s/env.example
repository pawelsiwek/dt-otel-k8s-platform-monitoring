# Environment variables required for `make deploy`.
# Copy this file to .env, fill in the values, then:
#   export $(cat .env | grep -v '^#' | xargs) && make deploy

# Full image reference — push to a registry your cluster can pull from.
COLLECTOR_IMAGE=myregistry.example.com/dt-otelcol-k8s:latest

# Image pull policy. Use IfNotPresent for a registry image, Never for kind.
IMAGE_PULL_POLICY=IfNotPresent

# Kubernetes cluster display name (used as a metric/entity dimension).
K8S_CLUSTER_NAME=my-cluster

# UID of the kube-system namespace — used as a stable cluster identifier.
# Retrieve with: kubectl get ns kube-system -o jsonpath='{.metadata.uid}'
K8S_CLUSTER_UID=

# Dynatrace OTLP ingest endpoint.
DT_ENDPOINT=https://<tenant>.live.dynatrace.com/api/v2/otlp

# Dynatrace API token — needs ingest.otlp and ingest.logs scopes.
DT_API_TOKEN=

# Dynatrace platform token (needed for platform-specific features).
DT_PLATFORM_TOKEN=

# Full image reference for the host-monitoring DaemonSet variant
# (debian-slim base with journalctl; required because the journald
# receiver shells out to the journalctl binary which is absent from
# the default distroless image).
HOST_COLLECTOR_IMAGE=myregistry.example.com/dt-otelcol-k8s-host:latest
