          "nodeIdFieldName": "dt.smartscape.k8s_cluster",
          "extractNode": true,
          "idComponents": [
            {
              "idComponent": "k8s.cluster.uid",
              "referencedFieldName": "k8s.cluster.uid"
            }
          ],
          "nodeName": {
            "type": "field",
            "field": {
              "sourceFieldName": "k8s.cluster.name"
            }
          },
          "fieldsToExtract": [
            {
              "fieldName": "k8s.cluster.name",
              "referencedFieldName": "k8s.cluster.name"
            },
            {
              "fieldName": "k8s.cluster.uid",
