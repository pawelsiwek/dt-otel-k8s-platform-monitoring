{
  "customId": "k8s-otel-metrics-enrichment",
  "displayName": "K8s OTel Metrics: Entity Enrichment",
  "metadataList": [],
  "smartscapeNodeExtraction": {
    "processors": [
      {
        "type": "smartscapeNode",
        "id": "enrich-k8s-cluster",
        "enabled": true,
        "description": "Enrich metrics with K8S_CLUSTER entity",
        "matcher": "isNotNull(k8s.cluster.uid)",
        "smartscapeNode": {
          "nodeType": "K8S_CLUSTER",
          "nodeIdFieldName": "dt.smartscape.k8s_cluster",
          "extractNode": false,
          "idComponents": [
            {
              "idComponent": "k8s.cluster.uid",
              "referencedFieldName": "k8s.cluster.uid"
            }
          ],
          "fieldsToExtract": [],
          "staticEdgesToExtract": []
        }
      },
      {
        "type": "smartscapeNode",
        "id": "enrich-k8s-namespace",
        "enabled": true,
        "description": "Enrich metrics with K8S_NAMESPACE entity",
        "matcher": "isNotNull(k8s.cluster.uid) and isNotNull(k8s.namespace.name)",
        "smartscapeNode": {
          "nodeType": "K8S_NAMESPACE",
          "nodeIdFieldName": "dt.smartscape.k8s_namespace",
          "extractNode": false,
          "idComponents": [
            {
              "idComponent": "k8s.cluster.uid",
              "referencedFieldName": "k8s.cluster.uid"
            },
            {
              "idComponent": "k8s.namespace.name",
              "referencedFieldName": "k8s.namespace.name"
            }
          ],
          "fieldsToExtract": [],
          "staticEdgesToExtract": []
        }
      },
      {
        "type": "smartscapeNode",
        "id": "enrich-k8s-node",
        "enabled": true,
        "description": "Enrich metrics with K8S_NODE entity",
        "matcher": "isNotNull(k8s.cluster.uid) and isNotNull(k8s.node.name)",
        "smartscapeNode": {
          "nodeType": "K8S_NODE",
          "nodeIdFieldName": "dt.smartscape.k8s_node",
          "extractNode": false,
          "idComponents": [
            {
              "idComponent": "k8s.cluster.uid",
              "referencedFieldName": "k8s.cluster.uid"
            },
            {
              "idComponent": "k8s.node.name",
              "referencedFieldName": "k8s.node.name"
            }
          ],
          "fieldsToExtract": [],
          "staticEdgesToExtract": []
        }
      },
      {
        "type": "smartscapeNode",
        "id": "enrich-k8s-pod",
        "enabled": true,
        "description": "Enrich metrics with K8S_POD entity",
        "matcher": "isNotNull(k8s.cluster.uid) and isNotNull(k8s.pod.uid)",
        "smartscapeNode": {
          "nodeType": "K8S_POD",
          "nodeIdFieldName": "dt.smartscape.k8s_pod",
          "extractNode": false,
          "idComponents": [
            {
              "idComponent": "k8s.cluster.uid",
              "referencedFieldName": "k8s.cluster.uid"
            },
            {
              "idComponent": "k8s.pod.uid",
              "referencedFieldName": "k8s.pod.uid"
            }
          ],
          "fieldsToExtract": [],
          "staticEdgesToExtract": []
        }
      },
      {
        "type": "smartscapeNode",
        "id": "enrich-k8s-deployment",
        "enabled": true,
        "description": "Enrich metrics with K8S_DEPLOYMENT entity",
        "matcher": "isNotNull(k8s.cluster.uid) and isNotNull(k8s.namespace.name) and isNotNull(k8s.deployment.name)",
        "smartscapeNode": {
          "nodeType": "K8S_DEPLOYMENT",
          "nodeIdFieldName": "dt.smartscape.k8s_deployment",
          "extractNode": false,
          "idComponents": [
            {
              "idComponent": "k8s.cluster.uid",
              "referencedFieldName": "k8s.cluster.uid"
            },
            {
              "idComponent": "k8s.namespace.name",
              "referencedFieldName": "k8s.namespace.name"
            },
            {
              "idComponent": "k8s.deployment.name",
              "referencedFieldName": "k8s.deployment.name"
            }
          ],
          "fieldsToExtract": [],
          "staticEdgesToExtract": []
        }
      },
      {
        "type": "smartscapeNode",
        "id": "enrich-k8s-daemonset",
        "enabled": true,
        "description": "Enrich metrics with K8S_DAEMONSET entity",
        "matcher": "isNotNull(k8s.cluster.uid) and isNotNull(k8s.namespace.name) and isNotNull(k8s.daemonset.name)",
        "smartscapeNode": {
          "nodeType": "K8S_DAEMONSET",
          "nodeIdFieldName": "dt.smartscape.k8s_daemonset",
          "extractNode": false,
          "idComponents": [
            {
              "idComponent": "k8s.cluster.uid",
              "referencedFieldName": "k8s.cluster.uid"
            },
            {
              "idComponent": "k8s.namespace.name",
              "referencedFieldName": "k8s.namespace.name"
            },
            {
              "idComponent": "k8s.daemonset.name",
              "referencedFieldName": "k8s.daemonset.name"
            }
          ],
          "fieldsToExtract": [],
          "staticEdgesToExtract": []
        }
      },
      {
        "type": "smartscapeNode",
        "id": "enrich-k8s-statefulset",
        "enabled": true,
        "description": "Enrich metrics with K8S_STATEFULSET entity",
        "matcher": "isNotNull(k8s.cluster.uid) and isNotNull(k8s.namespace.name) and isNotNull(k8s.statefulset.name)",
        "smartscapeNode": {
          "nodeType": "K8S_STATEFULSET",
          "nodeIdFieldName": "dt.smartscape.k8s_statefulset",
          "extractNode": false,
          "idComponents": [
            {
              "idComponent": "k8s.cluster.uid",
              "referencedFieldName": "k8s.cluster.uid"
            },
            {
              "idComponent": "k8s.namespace.name",
              "referencedFieldName": "k8s.namespace.name"
            },
            {
              "idComponent": "k8s.statefulset.name",
              "referencedFieldName": "k8s.statefulset.name"
            }
          ],
          "fieldsToExtract": [],
          "staticEdgesToExtract": []
        }
      },
      {
        "type": "smartscapeNode",
        "id": "enrich-k8s-replicaset",
        "enabled": true,
        "description": "Enrich metrics with K8S_REPLICASET entity",
        "matcher": "isNotNull(k8s.cluster.uid) and isNotNull(k8s.namespace.name) and isNotNull(k8s.replicaset.name)",
        "smartscapeNode": {
          "nodeType": "K8S_REPLICASET",
          "nodeIdFieldName": "dt.smartscape.k8s_replicaset",
          "extractNode": false,
          "idComponents": [
            {
              "idComponent": "k8s.cluster.uid",
              "referencedFieldName": "k8s.cluster.uid"
            },
            {
              "idComponent": "k8s.namespace.name",
              "referencedFieldName": "k8s.namespace.name"
            },
            {
              "idComponent": "k8s.replicaset.name",
              "referencedFieldName": "k8s.replicaset.name"
            }
          ],
          "fieldsToExtract": [],
          "staticEdgesToExtract": []
        }
      },
      {
        "type": "smartscapeNode",
        "id": "enrich-container",
        "enabled": true,
        "description": "Extract/enrich CONTAINER from container metrics (minimal node; image enriched by dtk8stopology)",
        "matcher": "isNotNull(k8s.cluster.uid) and isNotNull(k8s.pod.uid) and isNotNull(k8s.container.name)",
        "smartscapeNode": {
          "nodeType": "CONTAINER",
          "nodeIdFieldName": "dt.smartscape.container",
          "extractNode": true,
          "idComponents": [
            {
              "idComponent": "k8s.pod.uid",
              "referencedFieldName": "k8s.pod.uid"
            },
            {
              "idComponent": "k8s.container.name",
              "referencedFieldName": "k8s.container.name"
            }
          ],
          "nodeName": {
            "type": "field",
            "field": {
              "sourceFieldName": "k8s.container.name"
            }
          },
          "fieldsToExtract": [
            {
              "fieldName": "k8s.container.name",
              "referencedFieldName": "k8s.container.name",
              "strategy": "equals"
            },
            {
              "fieldName": "k8s.cluster.name",
              "referencedFieldName": "k8s.cluster.name",
              "strategy": "equals"
            },
            {
              "fieldName": "k8s.namespace.name",
              "referencedFieldName": "k8s.namespace.name",
              "strategy": "equals"
            },
            {
              "fieldName": "k8s.node.name",
              "referencedFieldName": "k8s.node.name",
              "strategy": "equals"
            },
            {
              "fieldName": "k8s.workload.name",
              "referencedFieldName": "k8s.workload.name",
              "strategy": "equals"
            },
            {
              "fieldName": "k8s.workload.kind",
              "referencedFieldName": "k8s.workload.kind",
              "strategy": "equals"
            }
          ],
          "staticEdgesToExtract": [
            {
              "edgeType": "is_part_of",
              "targetType": "K8S_POD",
              "targetIdFieldName": "dt.smartscape.k8s_pod"
            },
            {
              "edgeType": "belongs_to",
              "targetType": "K8S_CLUSTER",
              "targetIdFieldName": "dt.smartscape.k8s_cluster"
            },
            {
              "edgeType": "belongs_to",
              "targetType": "K8S_NAMESPACE",
              "targetIdFieldName": "dt.smartscape.k8s_namespace"
            },
            {
              "edgeType": "runs_on",
              "targetType": "K8S_NODE",
              "targetIdFieldName": "dt.smartscape.k8s_node"
            }
          ]
        }
      },
      {
        "type": "smartscapeNode",
        "id": "enrich-k8s-service",
        "enabled": true,
        "description": "Enrich metrics with K8S_SERVICE entity",
        "matcher": "isNotNull(k8s.cluster.uid) and isNotNull(k8s.namespace.name) and isNotNull(k8s.service.name)",
        "smartscapeNode": {
          "nodeType": "K8S_SERVICE",
          "nodeIdFieldName": "dt.smartscape.k8s_service",
          "extractNode": false,
          "idComponents": [
            {
              "idComponent": "k8s.cluster.uid",
              "referencedFieldName": "k8s.cluster.uid"
            },
            {
              "idComponent": "k8s.namespace.name",
              "referencedFieldName": "k8s.namespace.name"
            },
            {
              "idComponent": "k8s.service.name",
              "referencedFieldName": "k8s.service.name"
            }
          ],
          "fieldsToExtract": [],
          "staticEdgesToExtract": []
        }
      }
    ]
  }
}
